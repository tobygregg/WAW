{
  "name": "world-aid-walk",
  "version": "1.0.0",
  "description": "World Aid Walk Guernsey \u2014 website",
  "scripts": {
    "build": "tailwindcss -i ./assets/css/input.css -o ./assets/css/styles.css --minify",
    "dev": "tailwindcss -i ./assets/css/input.css -o ./assets/css/styles.css --watch",
    "build:three": "esbuild tools/three-entry.js --bundle --minify --format=iife --global-name=THREE --legal-comments=none --outfile=assets/vendor/three.custom.min.js",
    "serve": "npx --yes serve ."
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.19",
    "three": "^0.186.1"
  },
  "private": true
}